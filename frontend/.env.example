# このファイルをコピーして .env.local を作成し、実際の値を入れてください。
# .env.local はGit管理外(.gitignore)なので、ここには本物のキーを書かないこと。
#
#   cp .env.example .env.local

# --- Supabase Auth (Googleログイン) ---
# SupabaseプロジェクトのProject URL
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
# SupabaseプロジェクトのpublishableまたはAnon key(Secret keyはフロントに置かないこと)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- ローカルでバックエンドAPI/WebSocketに繋ぐための設定 ---
# 参加するルームのID
VITE_ROOM_ID=YOUR_ROOM_ID
# Go WebSocket APIのURL。backendをローカルで動かす場合の既定値
VITE_WS_URL=ws://127.0.0.1:8080/api/v1/ws
# Googleログインを使わずに動作確認したい場合の、開発用アクセストークン代わりの値
# (backend側をALLOW_ANONYMOUS=trueで動かす場合はこちらは不要)
VITE_SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN
